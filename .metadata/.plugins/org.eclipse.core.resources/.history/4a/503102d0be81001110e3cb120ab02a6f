package CSVFileTest;

import java.io.FileReader;
import java.io.IOException;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.testng.annotations.AfterTest;
import org.testng.annotations.BeforeTest;
import org.testng.annotations.Test;

import Utility.Helper;
import au.com.bytecode.opencsv.CSVReader;

public class CSVFileTest {
	WebDriver driver;
	String csvPath="C:\\CSVfileReading\\CSVfile.csv.xlsx";
	@BeforeTest
	public void  setup() {
		driver=Helper.startBrowser("chrome");
		driver.manage().window().maximize();
		driver.get("http://only-testing-blog.blogspot.com/2014/05/form.html");
		
	}
	@Test
	public void DDTTestingBlog() throws IOException, InterruptedException {
		CSVReader reader=new CSVReader(new FileReader(csvPath));
		String[] csvCell;
		while((csvCell = reader.readNext()) !=null){
			String fName= csvCell[0];
			String LName= csvCell[1];
			String Email= csvCell[4];
			String MNumb= csvCell[3];
			String CName= csvCell[2];
			driver.findElement(By.name("FirstName")).sendKeys(fName);
			driver.findElement(By.name("LastName")).sendKeys(LName);
			driver.findElement(By.name("EmailID")).sendKeys(Email);
			driver.findElement(By.name("MobNo")).sendKeys(MNumb);
			driver.findElement(By.name("Company")).sendKeys(CName);
			Thread.sleep(5000);
			driver.findElement(By.xpath("//input[@value='Submit']")).click();
			driver.switchTo().alert().accept();
			
		}
		reader.close();
		
	}
	@AfterTest
	public void closeDriver() {
		Helper.closeBrowser(driver);
	}

}
